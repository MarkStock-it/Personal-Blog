# Copy to .env on the server and fill in. .env is git-ignored and must never be committed.

# The port Apache proxies to for this subdomain. On ver.dcism.org each subdomain is provisioned as a
# portapp vhost: elyplog.dcism.org proxies to 127.0.0.1:20289 (baljeetflow uses 20288).
PORT=20289
HOST=127.0.0.1

# How many proxies sit in front of the app for X-Forwarded-For. One (Apache) is the default, which
# means the rightmost forwarded address is believed and anything the client sent is ignored. Set this
# to off if the app is ever reachable without a proxy in front of it: then no forwarded address is
# believed at all, and the per-IP rate limit cannot be forged.
TRUST_PROXY=1

# The most confirmation emails the process will send in an hour, whatever the request headers say.
# The Mailjet free plan allows 200 a day, so the default leaves room for real signups during a flood.
MAIL_HOURLY_CAP=40

# MariaDB on the same host. The account name is <user>_<suffix>, as on the web host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=s25103705_elyplog
DB_USER=s25103705_elyplog
DB_PASSWORD=

# The owner's sign-in name, shown on /login. Only this username plus the right password gets in.
ADMIN_USERNAME=markelysalinas

# Generate both with:  npm run hash -- "the admin password"
# ADMIN_PASSWORD_HASH is a scrypt record; SESSION_SECRET signs the session cookie.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Canonical origin, used for RSS, the sitemap and share metadata.
SITE_URL=https://elyplog.dcism.org

# Newsletter (Mailjet, free plan). Leave MAILJET_API_KEY blank to keep signups only in MariaDB.
# MAILJET_API_KEY and MAILJET_SECRET_KEY are the Mailjet API key pair; MAILJET_LIST_ID is the
# numeric id of the contact list confirmed subscribers join.
#
# MAILJET_FROM is the address the confirmation email is sent from. Mailjet only sends from a sender
# address that has been added and validated in the account (Senders & Domains), so it has to be one
# of those, and MAILJET_FROM_NAME is the name shown beside it.
#
# Without this block a signup is recorded but no confirmation link can be sent, so nobody can
# confirm and nobody joins the list. That is deliberate: the list has to be one people agreed to.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_LIST_ID=
MAILJET_FROM=
MAILJET_FROM_NAME=
