# Copy to .env on the server and fill in. .env is git-ignored and must never be committed.

# The port Apache proxies to for this subdomain. On ver.dcism.org each subdomain is provisioned as a
# portapp vhost: elyplog.dcism.org proxies to 127.0.0.1:20289 (baljeetflow uses 20288).
PORT=20289
HOST=127.0.0.1

# MariaDB on the same host. The account name is <user>_<suffix>, as on the web host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=s25103705_elyplog
DB_USER=s25103705_elyplog
DB_PASSWORD=

# The owner's sign-in name, shown on /login. Only this username plus the right password gets in.
ADMIN_USERNAME=markelysalinas

# Generate both with:  npm run hash -- "the admin password"
# ADMIN_PASSWORD_HASH is a scrypt record; SESSION_SECRET signs the session cookie.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Canonical origin, used for RSS, the sitemap and share metadata.
SITE_URL=https://elyplog.dcism.org
